{
    "name": "{{ name }}",
    "description": "",
    "type": "layer",
    "require": {
        "xefi/laravel-osdd": "*"
    },
    "autoload": {
        "psr-4": {
            "{{ namespace }}\\": "src/",
            "{{ namespace }}\\Database\\": "database/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
