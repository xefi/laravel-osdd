{
    "name": "{{ name }}",
    "description": "",
    "type": "layer",
    "require": {
        "xefi/laravel-osdd": "*"
    },
    "autoload": {
        "psr-4": {
            "{{ namespace }}\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{ namespace }}\\Providers\\{{ providerClass }}"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
