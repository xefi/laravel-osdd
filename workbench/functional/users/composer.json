{
    "name": "functional/users",
    "type": "layer",
    "require": {
        "xefi/laravel-osdd": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Functional\\Users\\Providers\\UsersServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Functional\\Users\\": "src/",
            "Functional\\Users\\Database\\Factories\\": "database/factories/",
            "Functional\\Users\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
