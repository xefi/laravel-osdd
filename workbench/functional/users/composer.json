{
    "name": "functional/users",
    "description": "Functional layer for the users part of the application",
    "type": "layer",
    "require": {
        "xefi/laravel-osdd": "*"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "Functional\\Users\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Functional\\Users\\\\Database\\Factories\\": "database/factories/",
            "Functional\\Users\\\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}